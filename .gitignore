# Celeste
ProjectCeleste*

# Item-icon sprite sheets — binary game art copied from the gitignored
# ProjectCeleste tree by scripts/build_sprites.py.  The position index
# (aoeo_market/web/static/sprites.json) is committed; the .webp sheets are not.
aoeo_market/web/static/sprites/

# Too specific to local setup
.python-version
*.env

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Test / tooling caches
.pytest_cache/

# Decompressed capture produced from the .gz at runtime
*.pcapng
*.pcapng.gz

# Market snapshot database (created by `fetch --store`)
market.db
market.db-*
market.db.wal

# Capture-dependent tests and their capture-derived reference data (local-only:
# the captures they need are not in version control, and the auth ones embed
# real account data)
tests/capture/
